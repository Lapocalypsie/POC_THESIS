<mxfile host="app.diagrams.net" pages="6">
  <diagram id="fig31" name="Fig 4.1 - Generic architecture (component types)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" value="Participants (type) Submit settlement instructions; hold balances. Subject to eligibility and access control (D4)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Compliance &amp; control (type) Enforce eligibility, holding limits and policy. Pre-validate; cannot itself settle." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="360" y="140" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="COORDINATION MECHANISM (type) Enforces the DvP guarantee across the two legs. The atomicity mechanism resides here (D3) - where the candidate architectures differ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="380" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Securities domain (type) Holds and transfers the asset leg; records ownership. Cannot move cash; acts only on a settlement instruction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="760" y="250" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="Cash domain (type) Holds and transfers central bank money with finality. Location and finality anchor not fixed (D1)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="760" y="520" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="CENTRAL BANK (individual component, not a type) Issues wCBDC, sets access, may intervene or suspend; may decline to operate on a third-party ledger." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="760" y="60" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="Settlement instruction (stimulus)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="n2" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="Eligibility &amp; policy checks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="Lock / transfer asset leg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="Trigger / confirm cash leg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;jettySize=auto;orthogonalLoop=1;" edge="1" parent="1" source="n4" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="Issues wCBDC; controls access" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;jettySize=auto;orthogonalLoop=1;strokeColor=#82b366;fontColor=#4d7a4d;" edge="1" parent="1" source="n7" target="n6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1100" y="160" />
              <mxPoint x="1100" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e13" value="Intervention / suspension rights" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;jettySize=auto;orthogonalLoop=1;strokeColor=#82b366;fontColor=#4d7a4d;" edge="1" parent="1" source="n7" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="System-level phenomenon (mechanism, 3.3): a settled DvP - the security leg settles if and only if the cash leg settles, with finality - or a safe failure. The requirements R constrain this behaviour; they do not fix how the coordination mechanism enforces it (parameters D1-D5; contextual factors)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#b8a800;fontSize=16;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="590" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="Boxes are component TYPES (Table 3.3); the central bank is an individual component. Arrows are interactions, not message flows - concrete flows appear only with the variants (Section 4.5)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#b8a800;fontSize=14;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="700" y="680" width="380" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="fig61" name="Fig 4.2 - Six-layer reference framework">
    <mxGraphModel dx="1414" dy="743" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=20;align=left;spacingLeft=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="L1 - Legal &amp; governance:  legal basis of register, token and finality; role allocation; enforceable central-bank control  |  R01, R02, R14  |  P1, P2, P8, P11, P17, P18" vertex="1">
          <mxGeometry height="80" width="900" x="80" y="60" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;align=left;spacingLeft=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;L2 - Participation &amp;amp; access:  admission, eligibility, KYC/AML, tiering; compliance-as-code with human override  |  R03, R16  |  P18, P19, P2, P3, P17   (R16 code-governance facet reaches L5)&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="900" x="80" y="160" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=20;align=left;spacingLeft=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" value="L3 - COORDINATED DvP SETTLEMENT ENGINE:  settlement asset; DvP mechanism; authoritative record; intraday liquidity; failure handling; pattern choice  |  R04, R05, R06, R09, R10, R13  |  P9, P12, P8, P11, P7, P13, P20 (+P21 arb.)" vertex="1">
          <mxGeometry height="90" width="900" x="80" y="260" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=22;align=left;spacingLeft=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;L4 - Interoperability:  links to RTGS/TARGET, CSDs, payment and messaging systems; standards  |  R07, R12  |  P20, P22   (R13&#39;s arbitration engages L4)&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="900" x="80" y="370" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=24;align=left;spacingLeft=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;L5 - Operations &amp;amp; resilience:  operational controls, resilience, auditability; confidentiality vs supervision  |  R08, R11  |  P3, P17, P18&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="900" x="80" y="470" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=26;align=left;spacingLeft=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;L6 - Transition &amp;amp; coexistence:  fragmentation limits; coexistence rules; migration roadmap  |  R15  |  P7, P9, P15, P20&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="900" x="80" y="570" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#b8a800;fontSize=18;align=left;verticalAlign=top;" value="Only L3 admits structurally distinct instantiations (3.3): the atomicity mechanism lives here. B1 - trigger (coordinator; rollback on confirmed rejection, recovery on timeout)&#xa;B2 - platform atomic commit&#xa;B3 - HTLC (hash-lock + time-lock)&#xa;&#xa;All other layers are stable across admissible architectures; what varies there are derived surfaces (supervisory interfaces, reconciliation), not mechanisms (4.3)." vertex="1">
          <mxGeometry height="430" width="300" x="1040" y="90" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="n4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;jettySize=auto;orthogonalLoop=1;dashed=1;" target="n8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="fig6x" name="Reading aid - How the six layers work together">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="The six layers are SEPARATIONS OF CONCERNS in one arrangement - not a pipeline. Nothing &#39;flows&#39; from L1 to L2 to L3. Every admissible architecture must instantiate ALL SIX (each layer carries requirements of R); only L3 varies structurally between B1 / B2 / B3." style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=20;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wrong" value="WRONG reading (pipeline):&#xa;L1 → L2 → L3 → L4 → L5 → L6&#xa;&#xa;A layer does not &#39;feed&#39; the next one." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="right" value="RIGHT reading (concerns):&#xa;L1 frames · L2 gates · L3 executes&#xa;L4 connects · L5 observes · L6 plans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="L1 - LEGAL &amp; GOVERNANCE (the constitution). Frames everything inside: the rulebook constitutes the authority that L2 enforces, L3 executes under, and L5 supervises with. R01 R02 R14" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=28;verticalAlign=top;align=left;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="1080" height="620" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="L2 - PARTICIPATION &amp; ACCESS (the door)&#xa;Who may hold, instruct, receive. Eligibility, KYC/AML, tiering, compliance-as-code. R03 R16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="420" y="330" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="L3 - SETTLEMENT ENGINE (the engine room)&#xa;The ONLY place settlement executes; the atomicity mechanism lives here.&#xa;R04 R05 R06 R09 R10 R13&#xa;&#xa;THE ONLY LAYER THAT VARIES:&#xa;B1 trigger | B2 platform commit | B3 HTLC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="300" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="L4 - INTEROPERABILITY (the plugs)&#xa;Links L3 to what it does not replace: RTGS / TARGET, CSD, messaging standards. R07 R12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1180" y="330" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ext" value="EXTERNAL WORLD&#xa;RTGS / TARGET · legacy CSD · payment &amp; messaging systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="800" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="L5" value="L5 - OPERATIONS &amp; RESILIENCE (the control room)&#xa;Watches and hardens the engine: controls, continuity, audit; confidentiality vs supervision. READ-ONLY toward settlement. R08 R11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="790" y="560" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="inst" value="Settlement instruction" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="240" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="admitted under L2 rules (precondition)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;" edge="1" parent="1" source="L2" target="L3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;" edge="1" parent="1" source="inst" target="L2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="serves L3 when a leg or record is off-platform (B1: cash leg; B3: second register)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;" edge="1" parent="1" source="L3" target="L4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;" edge="1" parent="1" source="L4" target="ext">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="observes (read-only)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;dashed=1;" edge="1" parent="1" source="L5" target="L3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="L6" value="L6 - TRANSITION &amp; COEXISTENCE (the calendar). Does not touch transactions at all: it governs how the WHOLE arrangement changes over time - fragmentation limits, coexistence with legacy, migration roadmap (e.g. B1 now, B2 later). R15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;verticalAlign=middle;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="770" width="760" height="90" as="geometry" />
        </mxCell>
        <mxCell id="note" value="One arrangement = one instantiation of each layer (six aspects of the same system, not six subsystems in sequence). A single transaction: enters through L2, executes in L3, may reach outside through L4, is observed by L5 - all of it with the legal force L1 gives, on the timeline L6 plans." style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=18;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="1420" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v4fig71" name="Fig 4.3 - Variant B1 Trigger (cash off-ledger)">
    <mxGraphModel dx="3957" dy="1238" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v4fig71_cb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=20;" value="Central bank control plane (L1/L3)" vertex="1">
          <mxGeometry height="75" width="492.8" x="67.2" y="50" as="geometry" />
        </mxCell>
        <mxCell id="v4fig71_sup" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=18;" value="Regulatory &amp; supervisory plane (L5) - read-only" vertex="1">
          <mxGeometry height="75" width="492.8" x="1189.44" y="35" as="geometry" />
        </mxCell>
        <mxCell id="v4fig71_iss" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" value="Issuer&#xa;(issuance / minting service)" vertex="1">
          <mxGeometry height="87.5" width="235.2" x="67.2" y="250" as="geometry" />
        </mxCell>
        <mxCell id="v4fig71_par" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=19;" value="Participants (OMS)&#xa;cosigned settlement instructions" vertex="1">
          <mxGeometry height="112.5" width="235.2" x="67.2" y="412.5" as="geometry" />
        </mxCell>
        <mxCell id="v4fig71_plat" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#666666;fontSize=23;fontStyle=1;spacingLeft=8;spacingTop=4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" value="Securities DLT platform (permissioned) - MIRROR side" vertex="1">
          <mxGeometry height="750" width="739.2" x="396.48" y="211.25" as="geometry" />
        </mxCell>
        <mxCell id="v4fig71_tok" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" value="Security token contract&#xa;MIRROR of the CSD record" vertex="1">
          <mxGeometry height="112.5" width="268.8" x="470.4" y="325" as="geometry" />
        </mxCell>
        <mxCell id="v4fig71_orc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=17;fontStyle=1;" value="TRIGGER ORCHESTRATOR - ACTIVE&#xa;lock &gt; trigger &gt; confirm &gt; release / rollback&#xa;Timeout manager: T_lock / T_conf -&gt; RECOVERY (I4c)&#xa;NEVER releases on expiry alone" vertex="1">
          <mxGeometry height="225" width="302.4" x="828.8" y="300" as="geometry" />
        </mxCell>
        <mxCell id="v4fig71_bus" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" value="DLT event bus&#xa;TokensLocked / Released / Transferred" vertex="1">
          <mxGeometry height="87.5" width="302.4" x="828.8" y="700" as="geometry" />
        </mxCell>
        <mxCell id="v4fig71_in1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;dashed=1;fontColor=#666666;" value="On-ledger DvP contract&#xa;INACTIVE (B2&#39;s mechanism)" vertex="1">
          <mxGeometry height="81.4" width="201.6" x="470.4" y="825" as="geometry" />
        </mxCell>
        <mxCell id="v4fig71_in2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;dashed=1;fontColor=#666666;" value="HTLC pair&#xa;INACTIVE (B3&#39;s mechanism)" vertex="1">
          <mxGeometry height="75" width="201.6" x="694.4" y="825" as="geometry" />
        </mxCell>
        <mxCell id="v4fig71_in3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;dashed=1;fontColor=#666666;" value="wCBDC contract - ABSENT&#xa;(this absence defines B1 vs B2)" vertex="1">
          <mxGeometry height="81.4" width="212.8" x="918.4" y="825" as="geometry" />
        </mxCell>
        <mxCell id="v4fig71_rtgs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=19;" value="RTGS - off-ledger (T2 / SIC)&#xa;Cash leg NEVER leaves the RTGS: central bank money by construction (R04); existing finality designation (R01)" vertex="1">
          <mxGeometry height="175" width="403.2" x="1279.04" y="300" as="geometry" />
        </mxCell>
        <mxCell id="v4fig71_csd" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;fontSize=23;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" value="CSD / Notary (L1/L3) - RECORD side" vertex="1">
          <mxGeometry height="275" width="313.6" x="67.2" y="650" as="geometry" />
        </mxCell>
        <mxCell id="v4fig71_gold" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=18;fontStyle=1;" value="AUTHORITATIVE REGISTER&#xa;GOLDEN RECORD (off-ledger; D2: CSD primary)" vertex="1">
          <mxGeometry height="100" width="268.8" x="81.76" y="800" as="geometry" />
        </mxCell>
        <mxCell id="v4fig71_e2" edge="1" parent="1" source="v4fig71_iss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=15;labelBackgroundColor=#ffffff;strokeColor=#999999;strokeWidth=1;jettySize=auto;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="v4fig71_gold" value="I1 issuance registration">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="67.17" y="291.83" />
              <mxPoint x="40" y="291.83" />
              <mxPoint x="40" y="850" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="v4fig71_e3" edge="1" parent="1" source="v4fig71_gold" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=15;labelBackgroundColor=#ffffff;strokeColor=#999999;strokeWidth=1;jettySize=auto;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.331;entryY=0.998;entryDx=0;entryDy=0;entryPerimeter=0;" target="v4fig71_tok" value="I2 token creation (CSD endorsement)">
          <mxGeometry relative="1" x="0.1747" y="-17" as="geometry">
