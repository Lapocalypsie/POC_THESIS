  <diagram id="v4fig72" name="Fig 4.4 - Variant B2 Integrated on-ledger (platform commit)">
    <mxGraphModel dx="1768" dy="929" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v4fig72_cb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=23;" value="Central bank control plane (L1/L3)" vertex="1"><mxGeometry height="60" width="440" x="60" y="40" as="geometry" /></mxCell>
        <mxCell id="v4fig72_sup" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=18;" value="Regulatory &amp; supervisory plane (L5) - read-only" vertex="1"><mxGeometry height="60" width="440" x="1100" y="40" as="geometry" /></mxCell>
