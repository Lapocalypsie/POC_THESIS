        <mxCell id="v4fig72_e7" edge="1" parent="1" source="v4fig72_wcb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#999999;strokeWidth=1;jettySize=auto;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.66;entryY=0;entryDx=0;entryDy=0;" target="v4fig72_bus" value="single publication">
