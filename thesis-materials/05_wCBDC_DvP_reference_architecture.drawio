  <diagram id="v4fig73" name="Fig 4.5 - Variant B3 HTLC cross-ledger (cryptographic locks)">
    <mxGraphModel dx="2020" dy="1061" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v4fig73_nl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;dashed=1;fontColor=#666666;" value="No central-bank WRITE authority on the securities register: authority passes through the rulebook only (L1). This is the B3 x R14 tension flagged in 4.3 / 4.6." vertex="1"><mxGeometry height="80" width="400" x="300" y="40" as="geometry" /></mxCell>
        <mxCell id="v4fig73_cb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" value="CENTRAL BANK - native governance of the CASH REGISTER ONLY.&#xa;Ex ante control: admission, ceilings, lock parameters, mint/burn, freeze. NO intervention point mid-protocol." vertex="1"><mxGeometry height="80" width="400" x="940" y="40" as="geometry" /></mxCell>
        <mxCell id="v4fig73_sel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=19;" value="SELLER participant&#xa;(holds the bond)" vertex="1"><mxGeometry height="80" width="200" x="60" y="200" as="geometry" /></mxCell>
        <mxCell id="v4fig73_buy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" value="BUYER participant&#xa;(holds wCBDC)" vertex="1"><mxGeometry height="80" width="200" x="1360" y="200" as="geometry" /></mxCell>
        <mxCell id="v4fig73_secl" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F19C99;strokeColor=#666666;fontSize=28;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" value="SECURITIES LEDGER - authoritative for the bond" vertex="1"><mxGeometry height="400" width="400" x="300" y="180" as="geometry" /></mxCell>
        <mxCell id="v4fig73_stok" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=22;" value="Security token contract&#xa;(authoritative record)" vertex="1"><mxGeometry height="70" width="360" x="320" y="230" as="geometry" /></mxCell>
        <mxCell id="v4fig73_shtlc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=17;fontStyle=1;" value="Securities HTLC contract&#xa;lock under (hashlock h, timeout T_sec)" vertex="1"><mxGeometry height="80" width="360" x="320" y="330" as="geometry" /></mxCell>
        <mxCell id="v4fig73_sh4" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=2;fontColor=#666666;" value="H4: refund to seller on expiry of T_sec" vertex="1"><mxGeometry height="31" width="360" x="320" y="415" as="geometry" /></mxCell>
        <mxCell id="v4fig73_sobs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" value="Event observation (per register)&#xa;lock / reveal natively public" vertex="1"><mxGeometry height="60" width="360" x="320" y="470" as="geometry" /></mxCell>
        <mxCell id="v4fig73_cashl" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F19C99;strokeColor=#666666;fontSize=28;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" value="CASH LEDGER - central-bank wCBDC register (distinct register: D1, D5)" vertex="1"><mxGeometry height="400" width="400" x="940" y="180" as="geometry" /></mxCell>
        <mxCell id="v4fig73_ctok" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=22;" value="wCBDC token contract&#xa;(CB-issued)" vertex="1"><mxGeometry height="70" width="360" x="960" y="230" as="geometry" /></mxCell>
        <mxCell id="v4fig73_chtlc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=17;fontStyle=1;" value="Cash HTLC contract&#xa;lock under (h, T_cash), with T_cash &lt; T_sec" vertex="1"><mxGeometry height="80" width="360" x="960" y="330" as="geometry" /></mxCell>
        <mxCell id="v4fig73_ch4" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=2;fontColor=#666666;" value="H4: refund to buyer on expiry of T_cash" vertex="1"><mxGeometry height="31" width="360" x="960" y="415" as="geometry" /></mxCell>
        <mxCell id="v4fig73_cobs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" value="Event observation (per register)" vertex="1"><mxGeometry height="60" width="360" x="960" y="470" as="geometry" /></mxCell>
        <mxCell id="v4fig73_noco" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;dashed=1;fontStyle=1;" value="NO COORDINATION COMPONENT&#xa;&#xa;no trusted third party: the joint behaviour of the two sovereign registers is fixed by ONE secret s and the strict nesting T_cash &lt; T_sec" vertex="1"><mxGeometry height="190" width="160" x="740" y="170" as="geometry" /></mxCell>
        <mxCell id="v4fig73_sup" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=17;" value="SUPERVISION - TWO read-only surfaces, one per register, correlated by transferId (R11)" vertex="1"><mxGeometry height="70" width="400" x="400" y="760" as="geometry" /></mxCell>
        <mxCell id="v4fig73_inv" parent="1" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=15;spacing=8;" value="WHAT GUARANTEES &#39;both legs or neither&#39; IN B3? Mathematics, not an institution: both locks open with the SAME secret s, and the cash window closes before the securities window (T_cash &lt; T_sec). The seller reveals s to take the cash - and revealing it hands the buyer the key to the bonds. If s is never revealed, both locks expire and each side gets its asset back (H4).&#xa;WHAT IT COSTS: nobody can step in mid-exchange - no coordinator exists (the B3 x R14 tension); a late signature near T_cash can expose one party, remedied by a premium [10] (open point, R10); the law must recognise a lock-conditioned transfer (B3 x R01).&#xa;WHAT PROVES IT: documented exploration only - TIPS Hash-Link, partial match [17]." vertex="1"><mxGeometry height="110" width="1480" x="60" y="960" as="geometry" /></mxCell>
        <mxCell id="v4fig73_e2" edge="1" parent="1" source="v4fig73_cb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#82b366;strokeWidth=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="v4fig73_cashl" value="C - ex ante only">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
