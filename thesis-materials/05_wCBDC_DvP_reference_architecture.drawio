        <mxCell id="v4fig72_par" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;" value="Participants (OMS)&#xa;cosigned settlement instructions" vertex="1"><mxGeometry height="90" width="210" x="60" y="340" as="geometry" /></mxCell>
        <mxCell id="v4fig72_plat" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F19C99;strokeColor=#666666;fontSize=28;fontStyle=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" value="SINGLE permissioned platform - the ledger IS the authoritative record (D2: native DLT record operated by or under the authority of a CSD - the SDX pattern); no second support, no reconciliation" vertex="1"><mxGeometry height="600" width="700" x="380" y="160" as="geometry" /></mxCell>
        <mxCell id="v4fig72_not" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" value="Notary / CSD node&#xa;endorses issuance" vertex="1"><mxGeometry height="60" width="250" x="420" y="220" as="geometry" /></mxCell>
        <mxCell id="v4fig72_tok" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=19;fontStyle=1;" value="Security token contract&#xa;GOLDEN RECORD (lifecycle on-ledger)" vertex="1"><mxGeometry height="90" width="250" x="420" y="320" as="geometry" /></mxCell>
        <mxCell id="v4fig72_dvp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;" value="ON-LEDGER DvP CONTRACT - ACTIVE&#xa;compliance check = explicit precondition of the swap (R16)&#xa;O1 + O2 grouped in ONE platform transaction" vertex="1"><mxGeometry height="140" width="290" x="760" y="300" as="geometry" /></mxCell>
        <mxCell id="v4fig72_wcb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" value="wCBDC token contract&#xa;native central bank money in token form" vertex="1"><mxGeometry height="80" width="290" x="760" y="490" as="geometry" /></mxCell>
        <mxCell id="v4fig72_bus" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=21;" value="UNIFIED event bus - both legs, ONE publication mechanism" vertex="1"><mxGeometry height="60" width="630" x="420" y="600" as="geometry" /></mxCell>
        <mxCell id="v4fig72_in1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;dashed=1;fontColor=#666666;" value="Trigger orchestrator - INACTIVE (B1)" vertex="1"><mxGeometry height="50" width="190" x="420" y="680" as="geometry" /></mxCell>
        <mxCell id="v4fig72_in2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;dashed=1;fontColor=#666666;" value="HTLC pair - INACTIVE (B3)" vertex="1"><mxGeometry height="50" width="190" x="630" y="680" as="geometry" /></mxCell>
        <mxCell id="v4fig72_in3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=15;dashed=1;fontColor=#666666;" value="Reconciliation - ABSENT (single support)" vertex="1"><mxGeometry height="50" width="210" x="840" y="680" as="geometry" /></mxCell>
        <mxCell id="v4fig72_rtgs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" value="RTGS (existing) - OUTSIDE the settlement path.&#xa;On-ramp only: intraday issuance / redemption of wCBDC against RTGS balances (R15)" vertex="1"><mxGeometry height="120" width="360" x="1180" y="470" as="geometry" /></mxCell>
        <mxCell id="v4fig72_inv" parent="1" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;spacing=8;" value="WHAT GUARANTEES &#39;both legs or neither&#39; IN B2? The platform itself: the bond transfer (O1) and the cash transfer (O2) sit inside ONE platform transaction, which commits entirely or not at all - like a single database transaction. There is never a moment where one leg has moved and the other has not.&#xa;WHAT IT COSTS: everything must live on one platform - central bank money must exist on-ledger (native wCBDC) and the law must recognise the ledger as the authoritative record (R01). Control = operations reserved to the central bank (C1 pause, C2 exclusive mint/burn) (R14); ONE supervisory surface sees both legs (R11).&#xa;WHAT PROVES IT: by construction (Chapter 5 proof of concept) and by reference (Helvetia II-III, Jura) [14][15][16]." vertex="1"><mxGeometry height="100" width="1480" x="60" y="810" as="geometry" /></mxCell>
        <mxCell id="v4fig72_e2" edge="1" parent="1" source="v4fig72_iss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#999999;strokeWidth=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="v4fig72_not" value="I1 issuance registration">
          <mxGeometry relative="1" x="-0.2727" y="15" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v4fig72_e3" edge="1" parent="1" source="v4fig72_not" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#999999;strokeWidth=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="v4fig72_tok" value="I2 mint into the golden record (CSD endorsement)">
          <mxGeometry relative="1" x="-0.5" y="135" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v4fig72_e4" edge="1" parent="1" source="v4fig72_par" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.64;entryDx=0;entryDy=0;" target="v4fig72_dvp" value="I3 transfer instruction">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
